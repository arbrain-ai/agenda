{
  "name": "agenda",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación y agenda de llamadas con tu marca: filtro, horarios, contador real, reagendar y recordatorios.",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "revisar": "tsx scripts/revisar-config.ts",
    "google:conectar": "node scripts/google-conectar.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx tests/e2e/recorrido.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "16.4.6",
    "nodemailer": "6.10.1",
    "postgres": "3.4.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/nodemailer": "6.4.17",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
