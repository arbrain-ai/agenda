# ─────────────────────────────────────────────────────────────────────────────────────────────
#  Copia este archivo a .env y llénalo. NUNCA subas tu .env a GitHub (ya está en .gitignore).
#  En tu computadora todo funciona sin llenar nada: los correos quedan en .datos/buzon.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Clave para entrar a tu panel (/admin). Mínimo 6 caracteres. Sin ella el panel queda cerrado.
ADMIN_CLAVE=

# Tu correo: aquí te llega un aviso por cada llamada nueva, movida o cancelada.
AVISOS_A=

# La dirección pública de tu agenda (para los enlaces de los correos). Ej.: https://agenda.tudominio.com
URL_PUBLICA=

# Secreto para firmar los enlaces de «Tu llamada». Genera uno con: openssl rand -hex 32
# Obligatorio si usas DATABASE_URL. Sin base de datos, si lo dejas vacío se crea solo en .datos/secreto.
AGENDA_SECRETO=

# ── Base de datos (opcional en tu computadora, obligatoria en Vercel) ─────────────────────────
# Postgres de Supabase, Neon o Railway. En Supabase: Connect → «Transaction pooler» (puerto 6543).
DATABASE_URL=

# ── Correos (opcional) ───────────────────────────────────────────────────────────────────────
# Sin SMTP_URL los correos NO salen: se guardan en .datos/buzon para que los veas.
# Gmail con contraseña de aplicación: smtps://tucorreo%40gmail.com:CONTRASENA_DE_APP@smtp.gmail.com:465
# Resend: smtps://resend:TU_LLAVE@smtp.resend.com:465
SMTP_URL=
# Quién firma los correos. Ej.: Consultoría Ejemplo <hola@tudominio.com>
CORREO_REMITENTE=

# ── Google Calendar (opcional) ───────────────────────────────────────────────────────────────
# Sácalos con: npm run google:conectar (te guía paso a paso).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Vacío = tu calendario principal.
GOOGLE_CALENDAR_ID=

# ── Recordatorios en Vercel ──────────────────────────────────────────────────────────────────
# En Vercel no hay un proceso prendido: un cron llama a /api/vuelta con este secreto (ver README).
CRON_SECRET=
